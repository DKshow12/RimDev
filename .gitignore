# 构建产物
engine/**/bin/
engine/**/obj/
.probe/

# ★ 探针/复核的中间产物（可重建，但可能上百 MB：Task 4b 的 gate4-check-all.json 就有 140 MB）。
#   记录 §7.3 早已把 `_rimdev\_tmp\` 写成 gitignored，而 .gitignore 里其实只有 .probe/ —— 补上，
#   免得一次 `git add -A` 把这些体积巨大的中间产物带进仓库。
_tmp/

# 索引缓存与报告（可重建）
cache/
cache-all/
reports/

# ★ tools/ 下的可复用探针源码**必须入库**（它们是知识，丢了要重写），只忽略构建产物。
#   规则顺序有讲究：`!` 例外必须写在忽略规则**之后**，否则不生效。
tools/**/bin/
tools/**/obj/

# 日志归档保留（真实语料，必须入库）
!logs/archive/*.log

# ★ dist/ 是 publish.ps1 的**产物**（两份 self-contained exe 共 136 MB），不入库。
#   生成方式：pwsh -File engine\publish.ps1
#   与 tools/**/bin 同理：构建产物忽略，生成脚本必须入库。
dist/
